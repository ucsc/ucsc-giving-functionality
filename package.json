{
  "name": "ucsc-giving-functionality-plugin",
  "version": "0.5.10",
  "description": "Custom functionality plugin for UCSC Giving site",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "release": "commit-and-tag-version",
    "dryrun": "commit-and-tag-version --dry-run",
    "test:release": "node --test tests/node/version-updater.test.js",
    "zip": "wp-scripts plugin-zip",
    "packages-update": "wp-scripts packages-update"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ucsc/ucsc-giving-functionality-plugin.git"
  },
  "keywords": [
    "wordpress",
    "plugin"
  ],
  "author": "UC Santa Cruz",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/ucsc/ucsc-giving-functionality-plugin/issues"
  },
  "homepage": "https://github.com/ucsc/ucsc-giving-functionality-plugin#readme",
  "devDependencies": {
    "@ucsantacruz/wordpress-version-updater": "^2.0.0",
    "@wordpress/scripts": "^34.0.0",
    "commit-and-tag-version": "^12.7.1"
  },
  "files": [
    "acf-json",
    "lib",
    "plugin.php",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "commit-and-tag-version": {
    "scripts": {
      "prerelease": "wordpress-version-updater check plugin.php"
    },
    "bumpFiles": [
      {
        "filename": "plugin.php",
        "updater": "node_modules/@ucsantacruz/wordpress-version-updater/index.js"
      },
      {
        "filename": "package-lock.json",
        "type": "json"
      },
      {
        "filename": "package.json",
        "type": "json"
      }
    ]
  }
}
